+
+bool PageSourceOf(uint32_t page, PageSource& out) {
+    if (page >= PageCount)
+        return false;
+    if (page < LatinPages) {
+        out = {true, Lang::Kor, page * PageRows};
+        return true;
+    }
+    const uint32_t k = page - LatinPages;
+    out = {false, Lang(k / CjkPages), (k % CjkPages) * PageRows};
+    return true;
+}
