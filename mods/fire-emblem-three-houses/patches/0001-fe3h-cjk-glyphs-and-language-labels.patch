+// SPDX-FileCopyrightText: Copyright 2026 Eden_Duo_Mode contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "fe3h_labels.h"
+
+namespace fe3h_labels {
+namespace {
+
+constexpr Entry Table[] = {
+#include "fe3h_labels_data.inc"
+};
+
+} // namespace
+
+const Entry* Entries() {
+    return Table;
+}
+
+size_t EntryCount() {
+    return sizeof(Table) / sizeof(Table[0]);
+}
+
+Column ColumnOf(int language) {
+    switch (language) {
+    case 0:
+        return Ja;
+    case 3:
+        return De;
+    case 4:
+    case 5:
+        return Fr;
+    case 6:
+    case 7:
+        return Es;
+    case 8:
+        return It;
+    case 9:
+        return Ko;
+    case 10:
+        return Twn;
+    case 11:
+        return Chn;
+    default: // 1 / 2 English, and an unknown language
+        return En;
+    }
+}
+
+const char* Own(const Entry& entry, int language) {
+    const char* text = entry.own[ColumnOf(language)];
+    return text ? text : entry.own[En];
+}
+
+std::string CleanGameText(const std::string& text) {
+    std::string out;
+    out.reserve(text.size());
+    for (const char c : text)
+        if (static_cast<unsigned char>(c) >= 0x20)
+            out.push_back(c);
+    return out;
+}
+
+std::string BuildProbe(const TextGetter& get) {
+    std::string probe;
+    for (const uint32_t index : ProbeIndices) {
+        std::string text;
+        if (!get(index, text))
+            return {};
+        text = CleanGameText(text);
+        if (text.empty())
+            return {};
+        probe += text;
+        probe += '|';
+    }
+    return probe;
+}
+
+int MatchLanguage(const std::string& probe, int preferred,
+                  const std::function<bool(int, uint32_t, std::string&)>& get) {
+    if (probe.empty())
+        return -1;
+    const auto matches = [&](int language) {
+        return BuildProbe([&](uint32_t index, std::string& out) { return get(language, index, out); }) ==
+               probe;
+    };
+    if (preferred >= 0 && preferred < LanguageCount && matches(preferred))
+        return preferred;
+    for (int language = 0; language < LanguageCount; ++language)
+        if (language != preferred && matches(language))
+            return language;
+    return -1;
+}
+
+} // namespace fe3h_labels
