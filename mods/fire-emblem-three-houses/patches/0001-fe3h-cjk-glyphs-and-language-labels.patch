index 0000000..cc14efd
--- /dev/null
+++ b/native/modules/fe3h_labels.h
@@ -0,0 +1,66 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden_Duo_Mode contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+// Fire Emblem: Three Houses (010055D009F78000): the companion's fixed words in the game's language.
+//
+// The manifest's `label` widgets bind "ui.l.<key>" (bind_text) instead of carrying English; the
+// module publishes the text for the game's language under those keys. Two sources:
+//   - a game term (a stat, a weapon skill, "Victory Conditions" ...) is read from the game's own
+//     message data at run time in the game's language (fe3h_text.h: part, index), so no game
+//     text ships and the wording is the game's;
+//   - a phrase the game has no word for is this companion's own text, one per column below
+//     (English = the fallback of everything).
+// The table is fe3h_labels_data.inc (generated).
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace fe3h_labels {
+
+// Own-text columns. The game's 12 languages share nine of them (msgdata order: 0 JPN, 1 ENG_U,
+// 2 ENG_E, 3 GER, 4 FRA_E, 5 FRA_U, 6 ESP_E, 7 ESP_U, 8 ITA, 9 KOR, 10 TWN, 11 CHN).
+enum Column : int { En, Ja, De, Fr, Es, It, Ko, Twn, Chn, ColumnCount };
+
+struct Entry {
+    const char* key;      // published as "ui.l." + key
+    int part;             // game text part (fe3h_text.h), -1 = none
+    int index;            // game text index in that part
+    const char* own[ColumnCount]; // nullptr = use En
+};
+
+// The table (generated) and its size.
+const Entry* Entries();
+size_t EntryCount();
+
+// Column of a game language index; English for an unknown (negative / out of range) one.
+Column ColumnOf(int language);
+
+// The text of `entry` in `language` without the game's text (own column, else English).
+const char* Own(const Entry& entry, int language);
+
+// A game text made fit for a label: the control codes (< 0x20) removed.
+std::string CleanGameText(const std::string& text);
+
+// ---- which language is the game running? ----------------------------------------------------
+// The game's language value (fe3h_reader.h, GameLanguage) can be wrong or unreadable, so the
+// language is also found by the game's own words: a few terms of message part 1 are read from the
+// game's memory and compared with the same terms of each language in the romfs message data. The
+// terms tell the CJK languages and German / French / Spanish / Italian apart; the regional
+// variants (ENG_U / ENG_E, FRA_E / FRA_U, ESP_E / ESP_U) have the same words here, so the first
+// (or the preferred) of them is taken, which is all the companion needs.
+inline constexpr uint32_t ProbeIndices[] = {257, 259, 598, 283, 284}; // Stats, Skill Level, Victory
+                                                                      // Conditions, Hit, Crit
+inline constexpr int LanguageCount = 12;
+// Reads one message-part-1 string by index; false when it is not available (yet).
+using TextGetter = std::function<bool(uint32_t index, std::string& out)>;
+// The terms joined with '|' (control codes removed); empty when any of them is not available.
+std::string BuildProbe(const TextGetter& get);
+// The language whose terms equal `probe`: `preferred` first, then 0..11; -1 when none matches or
+// the probe is empty. get(language, index, out) reads the message data of that language.
+int MatchLanguage(const std::string& probe, int preferred,
+                  const std::function<bool(int language, uint32_t index, std::string& out)>& get);
+
+} // namespace fe3h_labels
